# Application
NODE_ENV=development
PORT=3000

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=

# Target Repository
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_ORG=

# OpenAI
OPENAI_API_KEY=

# JWT
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters-long

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/article_supporter

# S3 Compatible Storage (RustFS for local development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=article-supporter
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
